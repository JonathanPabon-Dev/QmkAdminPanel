# Line endings: store LF in the repository, check out LF on every platform.
#
# Why: this repo is developed on Windows with `core.autocrlf=true` and had no
# .gitattributes. Git normalized on checkin but rewrote to CRLF on checkout, so
# `git status` reported files as modified that had zero real diff, and any
# `prettier --check` result depended on which machine ran it.
#
# `text=auto` keeps git's own text/binary detection, so assets such as
# public/graduation.svg stay untouched. `eol=lf` makes the working tree match
# the repository on Windows, macOS and Linux alike.
* text=auto eol=lf

# Never line-ending normalize archives or binary media, even if a future
# contributor adds one that `text=auto` would misjudge.
*.png    -text
*.jpg    -text
*.jpeg   -text
*.gif    -text
*.ico    -text
*.webp   -text
*.bmp    -text
*.pdf    -text
*.zip    -text
*.gz     -text
*.woff   -text
*.woff2  -text
*.ttf    -text
*.otf    -text
*.eot    -text
*.mp3    -text
*.mp4    -text

# Generated by pnpm; CI runs `pnpm install --frozen-lockfile` against it.
pnpm-lock.yaml -text

# Shell scripts must keep LF or they break under a POSIX sh.
*.sh text eol=lf
